# Dạng sóng và thư mục mô phỏng
*.vcd
*.wdb
*.wlf
xsim.dir/
sim.out
sim_*
!sim_*.v
sim_out/
# firmware/build/: ELF, .mem, disassembly do scripts/build_firmware.py sinh lại được
firmware/build/
# outfeed/: chỉ giữ kết quả FIR RTL (outfeed/test_*/actual.dat), bỏ file build XSim
/outfeed/tb_*/
# Phase 4.1 suite logs, images, baseline copies and local scratch helpers
/outfeed/phase41*/
/outfeed/phase41*.patch
/outfeed/*41.py
# Phase 5: Vivado synthesis output of scripts/run_vivado_synth.py (default outfeed/synth_<cfg>/)
/outfeed/synth_*/
# File phụ của XSim (xvlog.pb, xelab.pb, xsim_*.backup.*) nếu chạy tay ngoài outfeed/
*.pb
*.backup.*
# KHÔNG ignore *.mem / *.dat: là dữ liệu nguồn (ROM hệ số + shift_reg của IP trong
# rtl/Peripherals/FIR11/, vector data_test/fir_test/output/, dataset data_test/fir_1000/).
# program.mem / data.mem / symbols.mem chỉ sinh trong firmware/build/ và outfeed/tb_*/.

# File tạm / backup của editor
*~
*.bak
*.orig
*.swp
*.tmp
work/
transcript
modelsim.ini

# Vivado / Vitis
*.jou
*.log
*.str
.Xil/
*.comp/
webtalk*
# Vivado checkpoints / reports / batch by-products (fpga/synth_soc.tcl writes them to its out dir)
*.dcp
usage_statistics_webtalk.*
clockInfo.txt
.hbs/
*.bit
*.bin
*.ltx

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Workspace Vitis HLS: chỉ giữ mã nguồn, syn/verilog và syn/report
.autopilot/
.cache/
.wsdata/
.theia/
.debug/
.lock
logs/
impl/
*.o
*.bc
*.ll
*.d

# Python
__pycache__/
*.pyc

# Workspace Vitis HLS chứa đường dẫn tuyệt đối trên máy cá nhân: chỉ giữ syn/verilog + syn/report
hls/**/*_prj/*
!hls/**/*_prj/fir/
hls/**/*_prj/fir/*
!hls/**/*_prj/fir/hls/
hls/**/*_prj/fir/hls/*
!hls/**/*_prj/fir/hls/syn/
hls/**/*_prj/fir/hls/syn/vhdl/
